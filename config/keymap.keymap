#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp ESC       &kp N1     &kp N2    &kp N3    &kp N4       &kp N5                                                         &kp N6       &kp N7    &kp N8     &kp N9    &kp N0    &kp BSPC
&lt 3 TAB     &kp Q      &kp W     &kp E     &kp R        &kp T                                                          &kp Y        &kp U     &kp I      &kp O     &kp P     &kp ENTER
&kp CAPS      &kp A      &kp S     &kp D     &kp F        &kp G        &mkp LCLK                  &mkp RCLK              &kp H        &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT     &kp Z      &kp X     &kp C     &kp V        &kp B        &kp SPACE                  &kp RET                &kp N        &kp M     &kp COMMA  &kp DOT   &kp UP    &kp RSHFT
&mt LCTL ESC  &kp LCTRL  &kp LGUI  &kp LALT  &lt 1 SPACE  &lt 1 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &mt RSHIFT LANGUAGE_2  &lt 2 ENTER  &kp BSPC  &kp RALT   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        function {
            bindings = <
&kp GRAVE  &kp F1     &kp F2    &kp F3     &kp F4     &kp F5                  &kp F6   &kp F7     &kp F8     &kp F9  &kp F10  &kp BSPC
&tog_ls    &kp PG_UP  &kp UP    &kp PG_DN  &trans     &trans                  &kp F11  &kp F12    &trans     &trans  &trans   &trans
&trans     &kp LEFT   &kp DOWN  &kp RIGHT  &trans     &trans  &trans  &trans  &trans   &mkp LCLK  &mkp RCLK  &trans  &trans   &trans
&trans     &kp BKSP   &kp DEL   &trans     &trans     &trans  &trans  &trans  &trans   &trans     &trans     &trans  &trans   &trans
&trans     &trans     &trans    &trans     &kp ENTER  &trans  &trans  &trans  &trans   &trans     &trans     &trans  &trans   &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };

        BT {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
